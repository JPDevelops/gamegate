# systemd unit for the GameGate API.
# Install: sudo cp deploy/gamegate.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now gamegate
# Logs:    journalctl -u gamegate -f
[Unit]
Description=GameGate API (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Project/gamegate
EnvironmentFile=/home/ubuntu/Project/gamegate/.env
Environment=GAMEGATE_ENV=production
UMask=0077
# Sandboxing (review M13, B2). The API no longer shells out to sudo — connectors
# self-gate on an .env flag — so it can now drop privileges fully.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/Project/gamegate /home/ubuntu/Project/gamegate-data
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# --no-access-log: uvicorn's default access log writes the full request line
# (including /app?key=<token>) to journald in cleartext. nginx logs are already
# scrubbed; this closes the second copy (review M5).
ExecStart=/home/ubuntu/Project/gamegate/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
