# systemd unit for the GameGate Gmail poller (enable after OAuth setup).
# Install: sudo cp deploy/gamegate-gmail.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now gamegate-gmail
[Unit]
Description=GameGate Gmail poller
After=network.target gamegate.service
Wants=gamegate.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Project/gamegate
EnvironmentFile=/home/ubuntu/Project/gamegate/.env
Environment=GAMEGATE_ENV=production
UMask=0077
# Sandboxing (review M13). This unit doesn't shell out to sudo, so it can drop
# privileges fully. Writes token.json under the app dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/Project/gamegate
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ExecStart=/home/ubuntu/Project/gamegate/.venv/bin/python -m app.integrations.gmail_run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
