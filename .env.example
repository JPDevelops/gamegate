# GameGate configuration — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real secrets.

# Runtime environment: development | production.
# production REFUSES to start without GAMEGATE_API_TOKEN — deploy with this set.
# development = auth may run without a token + /docs enabled (local only).
# Set to production on a real deploy (a token is then REQUIRED to start).
GAMEGATE_ENV=development

# Shared secret for write endpoints (detector + connectors send it as
# X-GameGate-Token). Leave unset ONLY in local development.
GAMEGATE_API_TOKEN=

# SQLite database file
GAMEGATE_DB_PATH=gamegate.db

# Path to this .env (the dashboard's connector toggles rewrite it). Default: .env
# GAMEGATE_ENV_FILE=.env

# Gmail poll interval in seconds (gmail connector). Default: 120
# GMAIL_POLL_SECONDS=120

# NOTE: urgent break-through is a per-user setting in the dashboard (stored in
# the DB), not an env var. The host/port are set on the uvicorn command line in
# the systemd unit, not here.

# Integration credentials arrive with their milestones (Steps 6-8) — placeholders only:
# DISCORD_BOT_TOKEN=
# GAMEGATE_DISCORD_CHANNEL_ID=      # channel that receives digests/notifications
# GAMEGATE_DISCORD_GUILD_ID=        # ONLY this server may talk to the bot
# GAMEGATE_DISCORD_DELIVERY=false    # app is the notifier; set true to also deliver via Discord
# SLACK_ENABLED=false
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# GMAIL_OAUTH_CLIENT_ID=            # from Google console -> Clients -> gamegate-web
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=https://YOUR-HOST/oauth/gmail/callback
# GMAIL_ENABLED=false
# GMAIL_TOKEN_PATH=
# VIP senders are configured in the dashboard Settings (stored in the DB), not here.
# CLASSIFIER_ENABLED=false
# CLASSIFIER_MODEL=gpt-5-mini
# OPENAI_API_KEY=
# STEAMGRIDDB_API_KEY=                 # optional: game artwork lookups (/art)
# GAMEGATE_OWNER_DISCORD_ID=          # your Discord user id — your own messages are never ingested
